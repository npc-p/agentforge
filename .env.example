# ============================================================
#  AgentForge 环境变量
#  用法：cp .env.example .env  然后改 DEEPSEEK_API_KEY 即可
#  （docker compose 会自动读取同目录下的 .env）
# ============================================================

# ---------- 唯一需要你填的 ----------
# DeepSeek API Key，申请：https://platform.deepseek.com/api_keys
# 留空也能正常启动，但智能体运行在「确定性 Mock」模式：
#   界面全部可点、链路全通，回答是固定模板而非模型生成。
DEEPSEEK_API_KEY=

# ---------- 一般不用改 ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 向量化方式：
#   bge-m3  = 本地语义模型，检索质量最好（首次启动自动下载 2.2 GB）
#   hashing = 纯字符哈希，镜像轻、启动快，但不懂语义（零重叠查询会失效）
EMBED_PROVIDER=bge-m3

# 设为 0 可构建不含 torch 的轻量后端镜像（约省 1.5 GB），需同时设 EMBED_PROVIDER=hashing
WITH_LOCAL_EMBED=1

# 设为 1 可跳过演示数据初始化（知识库/数据集/评测套件）
SKIP_SEED=0

# 数据库 root 密码（仅容器内部使用，不对外暴露端口）
MYSQL_ROOT_PASSWORD=agentforge

# 端口映射：宿主机端口，冲突时改这里
BACKEND_PORT=8010
FRONTEND_PORT=3000
