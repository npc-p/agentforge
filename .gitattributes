# 统一换行符：仓库内一律 LF，检出时按平台自动转换
* text=auto eol=lf

# 明确标记二进制，避免 Git 尝试做文本 diff / 换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary

# Windows 批处理必须是 CRLF，否则 cmd 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 锁文件：合并时容易冲突且无意义，标记为二进制减少噪音
package-lock.json -diff linguist-generated
uv.lock -diff linguist-generated
