# ============================================================
# AgentForge 后端环境变量模板
# 用法：cp .env.example .env  然后填入真实密钥
# ============================================================

# ---------- 应用 ----------
ENV=dev
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- MySQL（JD 要求的关系型数据库）----------
# 需先手动建库：CREATE DATABASE agentforge DEFAULT CHARSET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/agentforge?charset=utf8mb4
# SQL 工具专用只读账号（强烈建议配置，最小权限原则）：
#   CREATE USER 'agentforge_ro'@'localhost' IDENTIFIED BY '你的密码';
#   GRANT SELECT ON agentforge.* TO 'agentforge_ro'@'localhost';
# 留空则回退到 DATABASE_URL，此时仅剩应用层表名白名单防护
READONLY_DATABASE_URL=
DB_ECHO=false

# ---------- LLM ----------
# provider 可选 deepseek | mock。mock 为离线确定性桩，无需任何 Key 即可跑通全链路
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------- 向量化 ----------
# hashing：纯 Python 字符 n-gram 哈希，零依赖离线可用（默认）
# openai ：任意 OpenAI 兼容 embeddings 端点（如 BGE-M3、text-embedding-3-small）
EMBED_PROVIDER=bge-m3
EMBED_MODEL=text-embedding-3-small
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=512
# 本地向量模型目录（provider=bge-m3 时生效），约 2.2G，需自行下载
EMBED_MODEL_PATH=./data/models/bge-m3
EMBED_BATCH_SIZE=8

# ---------- 向量库 ----------
# 当前已实现：chroma（内嵌，零运维）。Milvus/FAISS 为预留扩展点，未实现
VECTOR_STORE=chroma
CHROMA_DIR=./data/chroma

# ---------- Agent ----------
AGENT_MAX_STEPS=8
AGENT_MAX_PLAN_TASKS=6
AGENT_TOOL_TIMEOUT=20

# ---------- RAG ----------
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=6
RAG_VECTOR_WEIGHT=0.6
RAG_BM25_WEIGHT=0.4

# ---------- 文件 ----------
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_UPLOAD_MB=20
